generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SocialProvider {
  GOOGLE
  KAKAO
  APPLE
}

enum LicenseType {
  FIRST_NORMAL
  SECOND_NORMAL
}

enum FavoriteType {
  ACADEMY
  EXAM_CENTER
}

model User {
  id              String        @id @default(cuid())
  email           String?       @unique
  name            String
  avatarUrl       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  socialAccounts  SocialAccount[]
  quizAttempts    QuizAttempt[]
  wrongAnswers    WrongAnswer[]
  favorites       Favorite[]
}

model SocialAccount {
  id         String         @id @default(cuid())
  provider   SocialProvider
  providerId String
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
}

model AcademyCache {
  id          String   @id
  name        String
  address     String?
  latitude    Float
  longitude   Float
  phone       String?
  rating      Float?
  updatedAt   DateTime @updatedAt
}

model ExamSchedule {
  id          String      @id @default(cuid())
  providerId  String      @unique
  centerId    String
  centerName  String
  licenseType LicenseType
  category    String
  startsAt    DateTime
  endsAt      DateTime?
  bookingUrl  String
  source      String
  updatedAt   DateTime    @updatedAt

  @@index([startsAt, licenseType, centerId])
}

model Question {
  id          String      @id @default(cuid())
  licenseType LicenseType
  prompt      String
  choices     Json
  answerIndex Int
  explanation String
  isDemo      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  answers     QuizAnswer[]
  wrongAnswers WrongAnswer[]

  @@index([licenseType])
}

model QuizAttempt {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseType LicenseType
  mode        String
  score       Int
  total       Int
  durationSec Int
  completedAt DateTime    @default(now())
  answers     QuizAnswer[]

  @@index([userId, completedAt])
}

model QuizAnswer {
  id          String      @id @default(cuid())
  attemptId   String
  attempt     QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question    @relation(fields: [questionId], references: [id])
  selectedIndex Int
  isCorrect   Boolean
}

model WrongAnswer {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  updatedAt   DateTime @updatedAt

  @@unique([userId, questionId])
}

model Favorite {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      FavoriteType
  targetId  String
  label     String
  createdAt DateTime     @default(now())

  @@unique([userId, type, targetId])
}
